/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "voice-assistant",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Only the main workers.dev URL is public. Per-version preview URLs stay off so old
	// (e.g. pre-OAuth) versions can never be reached at their own addresses.
	"workers_dev": true,
	"preview_urls": false,
	// Stores OAuth clients, grants and tokens (props are encrypted by the OAuth library).
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "c7441925a2b9412d830bcca06a62c72e" }],
	"vars": {
		// Canonical MCP URL baked into every OAuth grant. Must match the connector URL exactly.
		// Overridden locally in .dev.vars with http://localhost:8787/mcp.
		"MCP_RESOURCE": "https://voice-assistant.vidyut-rajagopal2006.workers.dev/mcp",
		// Calendar used when the user doesn't name one (matched by name, case-insensitive).
		"DEFAULT_CALENDAR": "Daily Life",
		// IANA zone, so daylight saving is handled automatically.
		"TIME_ZONE": "America/New_York",
		// Spoken nicknames → calendar names (for words speech-to-text gets wrong).
		"CALENDAR_ALIASES": { "sock": "SOC" },
		// Timed events added to these calendars automatically get a Google Meet link.
		"MEET_CALENDARS": ["Waresport"],
		// Plaid environment: "sandbox" or "production". Overridden locally in .dev.vars.
		"PLAID_ENV": "production"
	},
	// Bank transactions, encrypted Plaid tokens, sync state (migrations/).
	// Create with: npx wrangler d1 create jarvis --binding DB --update-config
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jarvis",
			"database_id": "cb8470a5-8de1-45cb-9f25-be9a9bef5192",
			"migrations_dir": "migrations"
		}
	],
	// Bank work runs one small job per invocation (free plan: 10 ms CPU each).
	// Create with: npx wrangler queues create jarvis-bank-jobs
	"queues": {
		"producers": [{ "binding": "BANK_JOBS", "queue": "jarvis-bank-jobs" }],
		"consumers": [{ "queue": "jarvis-bank-jobs", "max_batch_size": 1, "max_retries": 8 }]
	},
	// UTC. Hourly: finish Link sessions whose webhook was missed. Daily: catch-up sync.
	"triggers": { "crons": ["0 * * * *", "30 11 * * *"] }
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}