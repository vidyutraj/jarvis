# Copy to .dev.vars (gitignored) and fill in real values for local development.
# In production, set each one with: npx wrangler secret put <NAME>

# From @BotFather when you create the bot.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Your personal chat ID with the bot (see README for how to find it).
TELEGRAM_CHAT_ID=replace-with-your-chat-id
